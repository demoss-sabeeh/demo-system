# Supabase project values. Publishable keys may be exposed to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only values. Never add a VITE_ prefix to these.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
OPERANTSCALE_PUBLIC_BUSINESS_ID=00000000-0000-4000-8000-000000000000
LOVABLE_API_KEY=optional-server-only-ai-gateway-key
